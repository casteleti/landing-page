---
// Mobile-only sticky checkout bar. Appears once the hero CTA scrolls away and
// hides again over the offer/final blocks so it never doubles up on a CTA the
// visitor can already see.
import Cta from './Cta.astro';
import Icon from './Icon.astro';
import { PRICE, COMBINED_VALUE } from '../config';
---

<div class="sticky-cta" id="sticky-cta" data-hidden aria-hidden="true">
  <div class="sticky-cta__inner">
    <div class="sticky-cta__price">
      <span class="sticky-cta__was">${COMBINED_VALUE} value</span>
      <span class="sticky-cta__now">{PRICE}</span>
    </div>
    <Cta label="Get Instant Access" position="sticky" fullWidthMobile={false} class="sticky-cta__button" />
  </div>
  <p class="sticky-cta__note">
    <Icon name="lock" size={12} />
    <span>Secure checkout · Instant download</span>
  </p>
</div>

<style>
  .sticky-cta {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 90;
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-top: 1px solid var(--border-light);
    box-shadow: 0 -6px 24px rgba(44, 48, 38, 0.12);
    padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
    transform: translateY(110%);
    transition: transform var(--duration-standard) var(--ease-standard);
  }

  .sticky-cta:not([data-hidden]) {
    transform: translateY(0);
  }

  @media (min-width: 900px) {
    .sticky-cta {
      display: none;
    }
  }

  .sticky-cta__inner {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .sticky-cta__price {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
    flex-shrink: 0;
  }

  .sticky-cta__was {
    font-family: var(--font-functional);
    font-size: 11.5px;
    color: var(--text-muted-aa);
    text-decoration: line-through;
  }

  .sticky-cta__now {
    font-family: var(--font-editorial);
    font-size: 30px;
    color: var(--brand-dark);
  }

  :global(.sticky-cta__button) {
    flex: 1;
    min-height: 54px;
    font-size: 16px;
    padding: 12px 14px;
  }

  .sticky-cta__note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin: 6px 0 0;
    font-family: var(--font-functional);
    font-size: 11.5px;
    color: var(--text-muted-aa);
  }

  .sticky-cta__note :global(svg) {
    color: var(--brand-green);
    flex-shrink: 0;
  }
</style>

<script>
  const bar = document.getElementById('sticky-cta');
  // Watch the hero SECTION, not the hero button. The button starts below the
  // fold on a phone, so observing it would report "already passed" at scroll 0
  // and slide the bar in before the visitor has seen any CTA at all.
  const hero = document.getElementById('hero');
  // Blocks that already show a CTA — the bar stands down while any is on screen.
  const quietZones = ['#offer', '#final-cta', '#stack']
    .map((sel) => document.querySelector(sel))
    .filter((el): el is Element => el !== null);

  if (bar && hero && 'IntersectionObserver' in window) {
    document.body.classList.add('has-sticky-cta');

    let heroPassed = false;
    let inQuietZone = false;

    const apply = () => {
      const show = heroPassed && !inQuietZone;
      bar.toggleAttribute('data-hidden', !show);
      bar.setAttribute('aria-hidden', String(!show));
    };

    new IntersectionObserver(
      ([entry]) => {
        heroPassed = !entry.isIntersecting;
        apply();
      },
      { threshold: 0 }
    ).observe(hero);

    if (quietZones.length) {
      const visible = new Set();
      const quietObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) visible.add(entry.target);
            else visible.delete(entry.target);
          }
          inQuietZone = visible.size > 0;
          apply();
        },
        { threshold: 0 }
      );
      quietZones.forEach((zone) => quietObserver.observe(zone));
    }
  }
</script>
