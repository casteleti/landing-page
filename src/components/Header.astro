---
// Section 1 — Header. design.md §6.8 · Docs/01-sections-copy.md SEÇÃO 1
import Cta from './Cta.astro';
import { BRAND_NAME, PRICE } from '../config';

// Full label would collide with the logo on a 360px screen; CSS swaps in the
// short one below 640px via the two spans.
const headerCtaLabel = `Get Access — ${PRICE}`;
---

<header class="site-header" id="header">
  <div class="container site-header__inner">
    <a href="#hero" class="site-header__logo" aria-label={`${BRAND_NAME} — home`}>
      {/* Below 400px the full lockup plus the CTA can't both fit, so the mark
          stands in rather than letting the lockup get squeezed out of ratio. */}
      <img
        class="site-header__logo-mark"
        src="/images/logo-mark.webp"
        width="128"
        height="128"
        alt=""
        fetchpriority="high"
        decoding="async"
      />
      <img
        class="site-header__logo-full"
        src="/images/logo-full.webp"
        width="689"
        height="120"
        alt=""
        fetchpriority="high"
        decoding="async"
      />
    </a>

    <div class="site-header__right">
      <p class="site-header__trust">
        Secure checkout <span aria-hidden="true">·</span> Instant digital access
      </p>
      <Cta
        label={headerCtaLabel}
        position="header"
        variant="secondary"
        fullWidthMobile={false}
        class="site-header__cta"
      />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg-main);
    transition: box-shadow var(--duration-standard) var(--ease-standard);
  }

  .site-header.is-sticky {
    box-shadow: var(--shadow-header-sticky);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    height: 64px;
  }

  @media (min-width: 900px) {
    .site-header__inner {
      height: 80px;
    }
  }

  .site-header__logo {
    display: block;
    /* Must not shrink: the global `img { max-width: 100% }` would then clamp the
       width while height stays fixed, distorting the lockup. */
    flex-shrink: 0;
    line-height: 0;
  }

  .site-header__logo img {
    width: auto;
    object-fit: contain; /* belt-and-braces: never stretch, whatever the box does */
  }

  .site-header__logo-mark {
    height: 32px;
  }

  .site-header__logo-full {
    display: none;
    height: 30px;
  }

  @media (min-width: 400px) {
    .site-header__logo-mark {
      display: none;
    }

    .site-header__logo-full {
      display: block;
    }
  }

  @media (min-width: 900px) {
    .site-header__logo-full {
      height: 40px;
    }
  }

  .site-header__right {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  .site-header__trust {
    display: none;
    margin: 0;
    font-family: var(--font-functional);
    font-size: 13px;
    color: var(--text-muted-aa);
    white-space: nowrap;
  }

  @media (min-width: 900px) {
    .site-header__trust {
      display: block;
    }
  }

  :global(.site-header__cta) {
    min-height: 42px;
    padding: 8px 14px;
    font-size: 14px;
    white-space: nowrap;
  }

  @media (min-width: 900px) {
    :global(.site-header__cta) {
      min-height: 48px;
      font-size: 15px;
      padding: 10px 24px;
    }
  }

  .site-header.is-sticky :global(.site-header__cta.cta--secondary) {
    background: var(--cta-primary);
    color: var(--white);
    border-color: var(--cta-primary);
  }
</style>

<script>
  const header = document.getElementById('header');
  const hero = document.getElementById('hero');

  if (header && hero && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        header.classList.toggle('is-sticky', !entry.isIntersecting);
      },
      { rootMargin: '0px', threshold: 0 }
    );
    observer.observe(hero);
  }
</script>
