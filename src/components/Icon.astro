---
// Linear icon set — stroke-based, currentColor, no fills, no emoji.
// design.md §6.4: stroke 1.5–2px, soft corners, no cartoon style.
export interface Props {
  name:
    | 'check'
    | 'dash'
    | 'checklist'
    | 'calendar'
    | 'bolt'
    | 'infinity'
    | 'lock'
    | 'shield'
    | 'graduation-cap'
    | 'document'
    | 'plus'
    | 'close'
    | 'chevron-down'
    | 'card';
  size?: number;
  class?: string;
  decorative?: boolean;
}

const { name, size = 20, class: className = '', decorative = true } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={decorative ? 'true' : undefined}
  role={decorative ? undefined : 'img'}
>
  {name === 'check' && <path d="M4 12.5 9.5 18 20 6" />}

  {name === 'dash' && <path d="M6 12h12" />}

  {name === 'checklist' && (
    <>
      <path d="M4 6h5M4 12h5M4 18h5" />
      <path d="M12.5 6.5 14 8l3-3.2" />
      <path d="M12.5 12.5 14 14l3-3.2" />
      <path d="M12.5 18.5 14 20l3-3.2" />
    </>
  )}

  {name === 'calendar' && (
    <>
      <rect x="4" y="5.5" width="16" height="15" rx="2.5" />
      <path d="M4 10h16" />
      <path d="M8 3.5v4M16 3.5v4" />
    </>
  )}

  {name === 'bolt' && <path d="M13 3 5 14h5.5L11 21l8-12h-5.5L13 3Z" />}

  {name === 'infinity' && (
    <path d="M7 9a4.5 4.5 0 0 0 0 9c2.5 0 3.8-2 5-4.5S15.5 9 18 9a4.5 4.5 0 0 1 0 9c-2.5 0-3.8-2-5-4.5S9.5 9 7 9Z" />
  )}

  {name === 'lock' && (
    <>
      <rect x="5" y="11" width="14" height="9.5" rx="2.2" />
      <path d="M8 11V8a4 4 0 0 1 8 0v3" />
    </>
  )}

  {name === 'shield' && (
    <path d="M12 3.5 19 6.5v5.2c0 4.6-3 7.9-7 9-4-1.1-7-4.4-7-9V6.5L12 3.5Z" />
  )}

  {name === 'graduation-cap' && (
    <>
      <path d="M12 4 2.5 8.5 12 13l9.5-4.5L12 4Z" />
      <path d="M6.5 10.7v4.3c0 1.6 2.5 3 5.5 3s5.5-1.4 5.5-3v-4.3" />
      <path d="M21.5 8.5V15" />
    </>
  )}

  {name === 'document' && (
    <>
      <path d="M7 3.5h7l4 4V19a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 6 19V5A1.5 1.5 0 0 1 7 3.5Z" />
      <path d="M14 3.5V8h4" />
      <path d="M9 12.5h6M9 16h6" />
    </>
  )}

  {name === 'plus' && (
    <>
      <path d="M12 5v14" />
      <path d="M5 12h14" />
    </>
  )}

  {name === 'close' && (
    <>
      <path d="M6 6l12 12" />
      <path d="M18 6 6 18" />
    </>
  )}

  {name === 'chevron-down' && <path d="m6 9 6 6 6-6" />}

  {name === 'card' && (
    <>
      <rect x="3" y="6" width="18" height="12" rx="2" />
      <path d="M3 10h18" />
    </>
  )}
</svg>
