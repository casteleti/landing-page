---
import Base from '../layouts/Base.astro';
import S01Header from '../sections/S01Header.astro';
import S02Hero from '../sections/S02Hero.astro';
import S03TrustBar from '../sections/S03TrustBar.astro';
import S04Problem from '../sections/S04Problem.astro';
import S05System from '../sections/S05System.astro';
import S06Blueprint from '../sections/S06Blueprint.astro';
import S07Bonuses from '../sections/S07Bonuses.astro';
import S08Stack from '../sections/S08Stack.astro';
import S09HowItWorks from '../sections/S09HowItWorks.astro';
import S10WhoItsFor from '../sections/S10WhoItsFor.astro';
import S11Preview from '../sections/S11Preview.astro';
import S12Creator from '../sections/S12Creator.astro';
import S13Offer from '../sections/S13Offer.astro';
import S14Guarantee from '../sections/S14Guarantee.astro';
import S15Faq from '../sections/S15Faq.astro';
import S16FinalCtaFooter from '../sections/S16FinalCtaFooter.astro';
import StickyCta from '../components/StickyCta.astro';
import { SHOW_PDF_PREVIEWS, SHOW_CREATOR_SECTION } from '../config';
---

<Base>
  <S01Header slot="header" />
  <S02Hero />
  <S03TrustBar />
  <S04Problem />
  <S05System />
  <S06Blueprint />
  <S07Bonuses />
  <S08Stack />
  <S09HowItWorks />
  <S10WhoItsFor />
  {SHOW_PDF_PREVIEWS && <S11Preview />}
  {SHOW_CREATOR_SECTION && <S12Creator />}
  <S13Offer />
  <S14Guarantee />
  <S15Faq />
  <S16FinalCtaFooter />
  <StickyCta slot="sticky" />
</Base>
