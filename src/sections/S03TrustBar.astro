---
// SEÇÃO 3 — TRUST BAR. Docs/01-sections-copy.md SEÇÃO 3
import Icon from '../components/Icon.astro';

const items = [
  'Instant digital access',
  'One-time payment',
  'Mobile-friendly + printable',
  'US & metric measurements',
  'Judgment-free, education-first',
];
---

<section id="trust-bar" class="trust-bar bg-white">
  <div class="container trust-bar__inner">
    {items.map((item) => (
      <p class="trust-bar__item">
        <Icon name="check" size={16} />
        <span>{item}</span>
      </p>
    ))}
  </div>
</section>

<style>
  .trust-bar {
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--border-light);
  }

  .trust-bar__inner {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2) var(--space-3);
  }

  @media (min-width: 900px) {
    .trust-bar__inner {
      grid-template-columns: repeat(5, auto);
      justify-content: center;
      gap: var(--space-4);
    }
  }

  .trust-bar__item {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-family: var(--font-functional);
    font-size: 14px;
    color: var(--text-secondary);
  }

  .trust-bar__item :global(svg) {
    color: var(--brand-green);
    flex-shrink: 0;
  }

  @media (min-width: 900px) {
    .trust-bar__item {
      font-size: 15px;
    }
  }
</style>
