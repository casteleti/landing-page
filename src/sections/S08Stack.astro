---
// SEÇÃO 8 — TUDO EM UM SÓ SISTEMA. Docs/01-sections-copy.md SEÇÃO 8
import Cta from '../components/Cta.astro';
import Icon from '../components/Icon.astro';
import { PRICE, COMBINED_VALUE } from '../config';

const items = [
  { name: 'The GLP-1 Success Blueprint™ (80–120 pages)', value: 67 },
  { name: 'Side Effect Survival Guide™', value: 37 },
  { name: 'First 30 Days Survival Guide™', value: 37 },
  { name: 'Protein Priority Playbook™', value: 27 },
  { name: 'Muscle Preservation Blueprint™', value: 37 },
  { name: 'Face & Body Defense Guide™', value: 27 },
  { name: 'Plateau Breaker Protocol™', value: 27 },
  { name: 'Life After GLP-1™', value: 37 },
  { name: 'High-Protein Recipe Book™', value: 47 },
  { name: 'Food Noise Workbook™', value: 27 },
  { name: 'Restaurant & Social Survival Guide™', value: 27 },
];
---

<section id="stack" class="section bg-cream">
  <div class="container stack">
    <div class="stack__visual">
      <img
        src="/images/stack-mockup.svg"
        width="500"
        height="562"
        alt="Stack of all eleven GLP-1 Success Blueprint guides"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="stack__content">
      <h2 class="h2" style="color: var(--brand-dark)">Everything You Get Today</h2>

      <ul class="stack__list">
        {items.map((item) => (
          <li>
            <span class="stack__list-name">
              <Icon name="check" size={16} />
              <span>{item.name}</span>
            </span>
            <span class="stack__list-value">${item.value}</span>
          </li>
        ))}
      </ul>

      <div class="stack__summary">
        <p class="stack__reference">Combined Reference Value: ${COMBINED_VALUE}</p>
        <p class="stack__today">Today: {PRICE} <span>one-time payment</span></p>
      </div>

      <Cta label={`Get Instant Access — ${PRICE}`} position="stack" />

      <p class="stack__microcopy">
        <Icon name="lock" size={14} />
        <span>Secure checkout <span aria-hidden="true">·</span> Instant access <span aria-hidden="true">·</span> No subscription</span>
      </p>
    </div>
  </div>
</section>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  @media (min-width: 900px) {
    .stack {
      flex-direction: row-reverse;
      align-items: center;
      gap: var(--space-8);
    }

    .stack__visual,
    .stack__content {
      flex: 1;
    }
  }

  .stack__visual img {
    width: 100%;
    max-width: 380px;
    margin-inline: auto;
  }

  .stack__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .stack__list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .stack__list li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    border-bottom: 1px dashed var(--border-light);
    padding-bottom: 8px;
  }

  .stack__list-name {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-functional);
    font-size: 15px;
    color: var(--brand-dark);
  }

  .stack__list-name :global(svg) {
    color: var(--brand-green);
    flex-shrink: 0;
  }

  .stack__list-value {
    font-family: var(--font-functional);
    font-size: 14px;
    color: var(--text-muted-aa);
    white-space: nowrap;
  }

  .stack__summary {
    margin-top: var(--space-2);
  }

  .stack__reference {
    font-family: var(--font-functional);
    font-weight: 400;
    font-size: 15px;
    color: var(--text-secondary);
    margin: 0;
  }

  .stack__today {
    font-family: var(--font-editorial);
    font-size: 34px;
    color: var(--brand-dark);
    margin: 4px 0 0;
  }

  .stack__today span {
    font-family: var(--font-functional);
    font-size: 16px;
    font-weight: 400;
    color: var(--text-secondary);
    margin-left: 8px;
  }

  .stack__microcopy {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-functional);
    font-size: 13px;
    color: var(--text-secondary);
  }

  .stack__microcopy :global(svg) {
    color: var(--brand-green);
  }
</style>
