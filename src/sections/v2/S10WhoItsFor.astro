---
// v2 SEÇÃO 10 — PARA QUEM É / NÃO É. Copy: src/content/copy-v2.ts
// The "not for you" column doubles as a trust signal: it states the two limits
// the research says buyers are actively scanning for (no taper protocol, no
// promise about regain).
import Icon from '../../components/Icon.astro';
import { WHO_V2 } from '../../content/copy-v2';
---

<section id="who-its-for" class="section bg-main">
  <div class="container who">
    <div class="who__card who__card--yes">
      <h3 class="h3">This is for you if you:</h3>
      <ul>
        {WHO_V2.forYou.map((line) => (
          <li>
            <Icon name="check" size={16} />
            <span class="body">{line}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="who__card who__card--no">
      <h3 class="h3">This is honestly not for you if you:</h3>
      <ul>
        {WHO_V2.notForYou.map((line) => (
          <li>
            <Icon name="dash" size={16} />
            <span class="body">{line}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .who {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  @media (min-width: 768px) {
    .who {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4);
    }
  }

  .who__card {
    background: var(--white);
    border-radius: var(--radius-card);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .who__card--yes {
    border: 2px solid var(--border-brand);
  }

  .who__card--no {
    border: 1px solid var(--border-light);
  }

  .who__card ul {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .who__card li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .who__card--yes :global(svg) {
    color: var(--brand-green);
    flex-shrink: 0;
    margin-top: 3px;
  }

  .who__card--no :global(svg) {
    color: var(--text-muted-aa);
    flex-shrink: 0;
    margin-top: 3px;
  }
</style>
