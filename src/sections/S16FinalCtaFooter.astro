---
// SEÇÃO 16 — CTA FINAL + FOOTER. Docs/01-sections-copy.md SEÇÃO 16
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
import { PRICE } from '../config';
---

<section id="final-cta" class="section bg-dark final-cta">
  <div class="container reading-column final-cta__inner">
    <h2 class="h2" style="color: #F7F5EF">
      Feel More Prepared for the Real-Life Side of Your GLP-1 Journey
    </h2>
    <p class="body final-cta__copy">
      Stop piecing it together from random posts and late-night searches. Get a practical,
      judgment-free system for your nutrition, routines, and long-term habits — starting
      today.
    </p>
    <Cta label={`Get Instant Access — ${PRICE}`} position="final" />
    <p class="final-cta__microcopy">
      Instant access <span aria-hidden="true">·</span> One-time payment <span aria-hidden="true">·</span> Secure checkout <span aria-hidden="true">·</span> 7-day guarantee
    </p>
  </div>
</section>

<Footer />

<style>
  .final-cta__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .final-cta__copy {
    color: var(--bg-cream);
  }

  .final-cta__microcopy {
    font-family: var(--font-functional);
    font-size: 13px;
    color: var(--bg-cream);
    opacity: 0.9;
  }
</style>
